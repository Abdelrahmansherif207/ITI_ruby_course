<% if notice.present? %>
  <div class="alert alert-success" role="alert">
    <%= notice %>
  </div>
<% end %>

<div class="card">
  <% if @article.image.attached? %>
    <div class="text-center p-3">
      <%= image_tag @article.image, class: "img-fluid rounded", style: "max-height: 400px;" %>
    </div>
  <% end %>
  
  <div class="card-body">
    <h1 class="card-title"><%= @article.title %></h1>
    <div class="card-text mb-4">
      <%= @article.body %>
    </div>

    <div class="d-flex gap-2">
      <% if current_user == @article.user %>
        <%= link_to "Edit", edit_article_path(@article), class: "btn btn-primary" %>
        <%= button_to "Delete", @article, method: :delete, 
            class: "btn btn-danger", 
            form: { data: { turbo_confirm: "Are you sure?" } } %>
      <% elsif current_user %>
        <%= button_to "Report Article", report_article_path(@article), method: :post,
            class: "btn btn-warning",
            data: { turbo_confirm: "Are you sure you want to report this article?" } %>
      <% end %>
      <%= link_to "Back", articles_path, class: "btn btn-secondary" %>
    </div>

    <div class="mt-3">
      <small class="text-muted">
        Status: <%= @article.status %>
        <% if @article.reports_count > 0 %>
          | Reports: <%= @article.reports_count %>
        <% end %>
      </small>
    </div>
  </div>
</div>
